[Unit]
Description=HAS_PrepperDisk mesh chat (Meshtastic <-> web bridge)
After=network.target local-fs.target
RequiresMountsFor=/library

[Service]
Type=simple
User=meshchat
Group=meshchat
SupplementaryGroups=dialout
Environment=HOME=/library/meshchat PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/has-meshchat
WorkingDirectory=/opt/has-meshchat
ExecStart=/opt/has-meshchat/venv/bin/python /opt/has-meshchat/meshchat.py
Restart=always
RestartSec=5

# Sıkılaştırma / hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/library/meshchat
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
